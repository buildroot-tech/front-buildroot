# Contact form (app/api/contact/route.ts) — Resend
# Get a key at https://resend.com after verifying buildroot.co as a
# sending domain (Resend > Domains > Add Domain, then add the DNS
# records it gives you). Without domain verification, RESEND_FROM_EMAIL
# must stay on resend's own onboarding domain, which is fine for local
# testing but not for production sends.
RESEND_API_KEY=

# Optional overrides — defaults live in app/api/contact/route.ts
# CONTACT_TO_EMAIL=info@buildroot.co
# CONTACT_FROM_EMAIL=Buildroot <contact@buildroot.co>
