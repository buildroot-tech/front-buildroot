ontent ── */}\n185:       <motion.div\n186:         className=\"relative flex h-[100vh] shrink-0 flex-col px-6 md:px-12\"\n187:         style={{\n188:           paddingTop: `${HEADER_H + 20}px`,\n189:           paddingBottom: \"28px\",\n190:           y,\n191:           opacity,\n192:         }}\n193:       >\n194:         {/* Coordinates & Dots — top right */}\n195:         <motion.div\n196:           className=\"flex flex-col items-end gap-6\"\n197:           initial={{ opacity: 0 }}\n198:           animate={{ opacity: 1 }}\n199:           transition={{ delay: 0.1, duration: 0.6 }}\n200:         >\n201:           <div className=\"font-mono text-[8px] uppercase tracking-[0.2em] text-[var(--text-inverse)] opacity-20 leading-relaxed text-right\">\n202:             <div>LAT: 00.83 N</div>\n203:             <div>LON: 77.64 W</div>\n204:           </div>\n205:           \n206:           <motion.div\n207:             className=\"grid grid-cols-5 gap-2.5\"\n208:             animate={{ y: [0, -7, 0], opacity: [0.12, 0.19, 0.12] }}\n209:             transition={{ duration: 9, repeat: Infinity, ease: \"easeInOut\" }}\n210:           >\n211:             {Array.from({ length: 25 }).map((_, i) => (\n212:               <div key={i} className=\"w-1 h-1 rounded-full bg-[var(--text-inverse)]\" />\n213:             ))}\n214:           </motion.div>\n215:         </motion.div>\n216: \n217:         {/* ── Headline — fills remaining space, anchored to bottom ── */}\n218:         <div className=\"flex-1 flex flex-col justify-center pb-[22vh] -translate-y-12 2xl:translate-y-4\">\n219: \n220:           {/* We build */}\n221:           <div className=\"overflow-hidden\">\n222:             <motion.h1\n223:               className=\"block font-display text-[var(--text-inverse)] uppercase\"\n224:               style={{ ...textBase, lineHeight: LH_MAIN }}\n225:               initial={{ y: \"106%\" }}\n226:               animate={{ y: 0 }}\n227:               transition={{ duration: 1, delay: 0.15, ease: [0.16, 1, 0.3, 1] }}\n228:             >\n229:               We build\n230:             </motion.h1>\n231:           </div>\n232: \n233:           {/* Digital */}\n234:           <div className=\"overflow-hidden\">\n235:             <motion.h1\n236:               className=\"block font-display text-[var(--text-inverse)] uppercase\"\n237:               style={{ ...textBase, lineHeight: LH_MAIN }}\n238:               initial={{ y: \"106%\" }}\n239:               animate={{ y: 0 }}\n240:               transition={{ duration: 1, delay: 0.28, ease: [0.16, 1, 0.3, 1] }}\n241:             >\n242:               Digital\n243:             </motion.h1>\n244:           </div>\n245: \n246:           {/* Products. — solid accent, z-10 so echo 1 goes behind */}\n247:           <div className=\"overflow-hidden relative z-10\">\n248:             <motion.h1\n249:               className=\"block font-display text-[var(--accent)] uppercase\"\n250:               style={{ ...textBase, lineHeight: LH_MAIN }}\n251:               initial={{ y: \"106%\" }}\n252:               animate={{ y: 0 }}\n253:               transition={{ duration: 1, delay: 0.42, ease: [0.16, 1, 0.3, 1] }}\n254:             >\n255:               Products.\n256:             </motion.h1>\n257:           </div>\n258: \n259:           {/* Ghost echoes — h-0 so they don't consume space, bleed downward */}\n260:           <motion.div\n261:             aria-hidden=\"true\"\n262:             className=\"h-0\"\n263:             initial={{ opacity: 0 }}\n264:             animate={{ opacity: 1 }}\n265:             transition={{ delay: 1.05, duration: 0.45 }}\n266:           >\n267:             {[0.16].map((opacity, i) => (\n268:               <span\n269:                 key={i}\n270:                 className=\"block font-display uppercase\"\n271:                 style={{\n272:                   ...textBase,\n273:                   lineHeight: 0.60,\n274:                   marginTop: i === 0 ? \"-0.30em\" : 0,\n275:                   WebkitTextStroke: `${i === 0 ? 2 : 1.5}px rgba(248,250,252,${opacity})`,\n276:                   color: \"transparent\",\n277:                 }}\n278:               >\n279:                 Products.\n280:               </span>\n281:             ))}\n282:           </motion.div>\n283:         </div>\n284: \n285:         {/* Services — bottom right */}\n286:         <motion.div\n287:           className=\"flex justify-end pt-4 pb-24\"\n288:           initial={{ opacity: 0 }}\n289:           animate={{ opacity: 1 }}\n290:           transition={{ delay: 1.3, duration: 0.6 }}\n291:         >\n292:           <div className=\"flex items-center gap-4\">\n293:             {SERVICES.map((s, i) => (\n294:               <span key={s} className=\"flex items-center gap-4\">\n295:                 <span className=\"font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-inverse)] opacity-35\">\n296:                   {s}\n297:                 </span>\n298:                 {i < SERVICES.length - 1 && (\n299:                   <span className=\"h-px w-3 bg-[var(--text-inverse)] opacity-20\" />\n300:                 )}\n301:               </span>\n302:             ))}\n303:           </div>\n304:         </motion.div>\n305:       </motion.div>\n306: \n307:       {/* Diagonal cut — 80px below viewport fold, visible on scroll */}\n308:       <div\n309:         className=\"absolute bottom-0 left-0 right-0 h-20 bg-[var(--bg-primary)] pointer-events-none\"\n310:         style={{ clipPath: \"polygon(0 100%, 100% 100%, 100% 0)\" }}\n311:       />\n312: \n313:       {/* Scroll line */}\n314:       <motion.div\n315:         className=\"absolute bottom-24 left-1/2 -translate-x-1/2 z-10\"\n316:         initial={{ opacity: 0 }}\n317:         animate={{ opacity: 1 }}\n318:         transition={{ delay: 2, duration: 0.6 }}\n319:         aria-hidden=\"true\"\n320:       >\n321:         <div className=\"relative h-8 w-px overflow-hidden\">\n322:           <motion.div\n323:             className=\"absolute inset-x-0 bg-[var(--accent)] opacity-60\"\n324:             animate={{ top: [\"-100%\", \"100%\"] }}\n325:             transition={{ duration: 1.2, repeat: Infinity, ease: \"easeInOut\" }}\n326:             style={{ height: \"50%\" }}\n327:           />\n328:         </div>\n329:       </motion.div>\n330:     </section>\n331:   );\n332: }\n333: \nThe above content shows the entire, complete file contents of the requested file.\n"}
