{"step_index":727,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-07-24T02:31:24Z","content":"Created At: 2026-07-23T21:31:24-05:00\nCompleted At: 2026-07-23T21:31:25-05:00\nFile Path: `file:///home/clouder/Documents/projects/buildroot/front-buildroot/components/ui/PixelImage.tsx`\nTotal Lines: 88\nTotal Bytes: 2905\nShowing lines 1 to 88\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\n2: \n3: import { useEffect, useRef } from \"react\";\n4: import { animate } from \"framer-motion\";\n5: \n6: export function PixelImage({ src }: { src: string }) {\n7:   const canvasRef = useRef<HTMLCanvasElement>(null);\n8: \n9:   useEffect(() => {\n10:     const canvas = canvasRef.current;\n11:     if (!canvas) return;\n12:     \n13:     const ctx = canvas.getContext(\"2d\");\n14:     if (!ctx) return;\n15: \n16:     let animationRef: any;\n17: \n18:     const img = new window.Image();\n19:     img.src = src;\n20:     \n21:     img.onload = () => {\n22:       // Use the image's raw high-resolution dimensions for the canvas internal buffer\n23:       // This prevents the canvas from capturing a tiny width while the CSS animation is opening it\n24:       canvas.width = img.naturalWidth;\n25:       canvas.height = img.naturalHeight;\n26:       \n27:       const width = canvas.width;\n28:       const height = canvas.height;\n29: \n30:       const draw = (pixelSize: number) => {\n31:         ctx.clearRect(0, 0, width, height);\n32: \n33:         // When pixelSize is 1 or less, draw the crisp high-res image\n34:         if (pixelSize <= 1.05) {\n35:           ctx.imageSmoothingEnabled = true; // Enable smoothing for the crisp final photo\n36:           ctx.drawImage(img, 0, 0, width, height);\n37:           return;\n38:         }\n39: \n40:         // Calculate downscaled dimensions (how many logical blocks)\n41:         const scaledW = Math.max(1, Math.floor(width / pixelSize));\n42:         const scaledH = Math.max(1, Math.floor(height / pixelSize));\n43: \n44:         // Use offscreen canvas to create the pixel data\n45:         const offscreen = document.createElement(\"canvas\");\n46:         offscreen.width = scaledW;\n47:         offscreen.height = scaledH;\n48:         const offCtx = offscreen.getContext(\"2d\");\n49:         \n50:         if (offCtx) {\n51:           offCtx.drawImage(img, 0, 0, scaledW, scaledH);\n52:           \n53:           // Draw the pixelated blocks\n54:           ctx.imageSmoothingEnabled = false;\n55:           ctx.globalAlpha = 1;\n56:           ctx.drawImage(offscreen, 0, 0, width, height);\n57:         }\n58: \n59:         // SMOOTHING MAGIC: Crossfade the perfectly sharp image on top \n60:         // This hides the 'mechanical' jitter of the resizing blocks and makes it melt\n61:         const progress = 1 - ((pixelSize - 1) / (initialPixelSize - 1));\n62:         \n63:         // Exponential fade-in for buttery smoothness\n64:         ctx.globalAlpha = progress * progress * progress; \n65:         ctx.imageSmoothingEnabled = true;\n66:         ctx.drawImage(img, 0, 0, width, height);\n67:         \n68:         // Reset alpha for next frame\n69:         ctx.globalAlpha = 1;\n70:       };\n71: \n72:       // Animate block size down to 1px (sharp)\n73:       animationRef = animate(initialPixelSize, 1, {\n74:         duration: 0.8,\n75:         ease: \"easeOut\",\n76:         onUpdate: (latest) => draw(latest),\n77:         onComplete: () => draw(1) // Guarantee it finishes perfectly clear\n78:       });\n79:     };\n80: \n81:     return () => {\n82:       if (animationRef) animationRef.stop();\n83:     };\n84:   }, [src]);\n85: \n86:   return <canvas ref={canvasRef} className=\"absolute inset-0 w-full h-full object-cover\" />;\n87: }\n88: \nThe above content shows the entire, complete file contents of the requested file.\n"}
