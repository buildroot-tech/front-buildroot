ase: [0.25, 0.1, 0.25, 1] as const },\n  },\n};\n\ninterface WorkflowStepsProps {\n  dict?: any;\n}\n\nexport function WorkflowSteps({ dict }: WorkflowStepsProps) {\n  const localizedSteps = steps.map((step, index) => {\n    const dictStep = dict?.steps?.[index];\n    return {\n      ...step,\n      title: dictStep?.title || step.title,\n      description: dictStep?.desc || step.description,\n    };\n  });\n\n  return (\n    <section className=\"section-generous bg-[var(--bg-secondary)]\">\n      <div className=\"container-padded\">\n        {/* Header */}\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.6 }}\n        >\n          <p className=\"font-mono text-xs uppercase tracking-[0.2em] text-[var(--accent)]\">\n            {dict?.title || \"How We Work\"}\n          </p>\n          <h2 className=\"heading text-h2 mt-4\">Our Process</h2>\n        </motion.div>\n\n        {/* Steps */}\n        <motion.div\n          className=\"mt-12 grid gap-0 border-2 border-[var(--border)]\"\n          variants={container}\n          initial=\"hidden\"\n          whileInView=\"visible\"\n          viewport={{ once: true }}\n        >\n          {localizedSteps.map((step, i) => (\n            <motion.div\n              key={step.number}\n              className={`flex flex-col sm:flex-row ${\n                i < steps.length - 1 ? \"border-b-2 border-[var(--border)]\" : \"\"\n              }`}\n              variants={item}\n            >\n              {/* Number */}\n              <div className=\"flex w-full sm:w-32 items-center justify-center border-b-2 border-[var(--border)] bg-[var(--bg-hero)] py-6 sm:border-b-0 sm:border-r-2 sm:py-12\">\n                <span className=\"font-mono text-4xl font-bold text-[var(--text-inverse)]\">\n                  {step.number}\n                </span>\n              </div>\n\n              {/* Content */}