75:             className=\"brutalist-button brutalist-button-accent text-xs\"\n76:           >\n77:             View All Projects →\n78:           </Link>\n79:         </div>\n80:       </div>\n81: \n82:       {/* Floating Image attached to Cursor */}\n83:       <AnimatePresence>\n84:         {hoveredProject && (\n85:           <motion.div\n86:             initial={{ opacity: 0, scale: 0.5, rotate: -5 }}\n87:             animate={{ opacity: 1, scale: 1, rotate: 0 }}\n88:             exit={{ opacity: 0, scale: 0.5, rotate: 5 }}\n89:             transition={{ type: \"spring\", stiffness: 100, damping: 20 }}\n90:             className=\"fixed pointer-events-none z-50 hidden md:block\"\n91:             style={{\n92:               left: x - imageWidth / 2,\n93:               top: y - imageHeight / 2,\n94:               width: imageWidth,\n95:               height: imageHeight,\n96:             }}\n97:           >\n98:             <div className=\"relative w-full h-full border-2 border-[var(--border)] shadow-[16px_16px_0px_0px_var(--accent)] overflow-hidden bg-[var(--bg-hero)]\">\n99:               <Image\n100:                 src={`/projects/${getImageName(hoveredProject)}.jpg`}\n101:                 alt=\"Project Preview\"\n102:                 fill\n103:                 sizes=\"350px\"\n104:                 className=\"object-cover\"\n105:                 priority\n106:               />\n107:               {/* Overlay */}\n108:               <div className=\"absolute inset-0 bg-black/20 mix-blend-multiply\" />\n109:             </div>\n110:             \n111:             {/* View Project Floating Tag */}\n112:             <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-[var(--bg-hero)] text-[var(--text-inverse)] border border-[var(--text-inverse)] font-mono text-xs uppercase px-4 py-2 rounded-full whitespace-nowrap shadow-lg backdrop-blur-sm\">\n113:               View Case ↗\n114:             </div>\n115:           </motion.div>\n116: 