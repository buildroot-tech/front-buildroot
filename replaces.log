tContent":"  // Track scroll progress across this specific component\n  const { scrollYProgress } = useScroll({\n    target: container,\n    offset: [\"start 80%\", \"center center\"] // Finishes exactly when the text block is centered in the viewport\n  });","StartLine":14,"TargetContent":"  // Track scroll progress across this specific component\n  const { scrollYProgress } = useScroll({\n    target: container,\n    offset: [\"start 75%\", \"end 75%\"] // Progress maps perfectly to the element passing the 75% mark on the screen\n  });","TargetFile":"/home/clouder/Documents/projects/buildroot/front-buildroot/components/home/CTA.tsx","toolAction":"Adjust offset for early reveal","toolSummary":"File edit"}}]}
