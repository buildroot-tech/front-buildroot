86:   font-weight: 600;\n187:   font-size: var(--text-small);\n188:   text-transform: uppercase;\n189:   letter-spacing: 0.05em;\n190:   cursor: pointer;\n191:   transition: box-shadow var(--duration-hover) ease,\n192:     transform var(--duration-hover) ease;\n193: }\n194: \n195: .brutalist-button:hover {\n196:   box-shadow: var(--shadow-brutalist-hover);\n197:   transform: translate(2px, 2px);\n198: }\n199: \n200: .brutalist-button:active {\n201:   box-shadow: none;\n202:   transform: translate(4px, 4px);\n203: }\n204: \n205: /* Accent button */\n206: .brutalist-button-accent {\n207:   background: var(--accent);\n208:   color: var(--text-inverse);\n209:   border-color: var(--accent);\n210: }\n211: \n212: .brutalist-button-accent:hover {\n213:   background: var(--accent-hover);\n214:   border-color: var(--accent-hover);\n215: }\n216: \n217: /* ============================================\n218:    LAYOUT UTILITIES\n219:    ============================================ */\n220: \n221: .container-padded {\n222:   width: 100%;\n223:   max-width: 1400px;\n224:   margin: 0 auto;\n225:   padding-left: var(--space-normal-md);\n226:   padding-right: var(--space-normal-md);\n227: }\n228: \n229: .section-generous {\n230:   padding-top: var(--space-generous-md);\n231:   padding-bottom: var(--space-generous-md);\n232: }\n233: \n234: .section-normal {\n235:   padding-top: var(--space-normal-lg);\n236:   padding-bottom: var(--space-normal-lg);\n237: }\n238: \n239: .section-bleed {\n240:   padding-top: 0;\n241:   padding-bottom: 0;\n242: }\n243: \n244: /* ============================================\n245:    CURSOR BLINK\n246:    ============================================ */\n247: \n248: @keyframes blink {\n249:   0%, 100% { opacity: 1; }\n250:   50% { opacity: 0; }\n251: }\n252: \n253: .cursor-blink {\n254:   animation: blink 1s step-end infinite;\n255: }\n256: \n257: /* ============================================\n258:    SCROLLBAR (brutalist)\n259:    ============================================ */\n260: \n261: ::-webkit-scrollbar {\n262:   width: 8px;\n263: }\n264: \n265: ::-webkit-scrollbar-track {\n266:   background: var(--bg-primary);\n267: }\n268: \n269: ::-webkit-scrollbar-thumb {\n270:   background: var(--border);\n271:   border: 1px solid var(--bg-primary);\n272: }\n273: \n274: /* ============================================\n275:    SELECTION\n276:    ============================================ */\n277: \n278: ::selection {\n279:   background: var(--accent);\n280:   color: var(--text-inverse);\n281: }\n282: \nThe above content shows the entire, complete file contents of the requested file.\n"}
