{"step_index":546,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-07-23T22:02:42Z","content":"Created At: 2026-07-23T17:02:42-05:00\nCompleted At: 2026-07-23T17:02:42-05:00\nFile Path: `file:///home/clouder/Documents/projects/buildroot/front-buildroot/lib/projects.ts`\nTotal Lines: 220\nTotal Bytes: 10312\nShowing lines 1 to 220\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { Project } from \"@/types\";\n2: export const PROJECTS: readonly Project[] = [\n3:   {\n4:     id: \"polo-pantoja-platform\",\n5:     indexCode: \"01\",\n6:     title: \"Polo & Pantoja Digital Platform\",\n7:     client: \"Polo & Pantoja Abogados\",\n8:     year: \"2026\",\n9:     category: \"SaaS\",\n10:     featured: true,\n11:     summary: \"Law firm portal & specialized real estate marketplace with anticres contract management.\",\n12:     description:\n13:       \"Full-stack legal service portal combined with a regional real estate marketplace handling rentals, sales, and Colombian anticres property contracts with role-based document access.\",\n14:     tags: [\"Next.js 14\", \"Spring Boot 3\", \"Java 17\", \"PostgreSQL\", \"Clean Architecture\", \"JWT\"],\n15:     metrics: [\n16:       { label: \"Contract Modalities\", value: \"3 (Rent/Sale/Anticres)\" },\n17:       { label: \"Security\", value: \"Spring Sec + RBAC\" },\n18:       { label: \"Architecture\", value: \"Modular Monolith\" },\n19:     ],\n20:     caseStudy: {\n21:       challenge:\n22:         \"Polo & Pantoja needed a unified solution for legal services and a regional real estate marketplace supporting anticres contracts—a unique legal modality requiring strict document verification.\",\n23:       solution:\n24:         \"Architected a modular monolith backend in Spring Boot 3 with Clean Architecture and a Next.js 14 App Router frontend. Built custom document verification workflows for law firm admins and property owners.\",\n25:       architecture: [\n26:         \"Spring Boot 3 + Java 17 Controller-Service-Repository clean layers\",\n27:         \"Next.js 14 App Router with server-side rendered listings\",\n28:         \"JWT Authentication + Role-Based Access Control (Admin, Owner, Client)\",\n29:         \"PostgreSQL database with soft-delete repositories\",\n30:       ],\n31:       results: [\n32:         \"Unified legal showcase & property management into a single platform\",\n33:         \"Streamlined property verification time for law firm staff\",\n34:         \"Multi-role security strategy for secure contract handling\",\n35:       ],\n36:     },\n37:     demoUrl: \"https://polopantoja.co\",\n38:   },\n39:   {\n40:     id: \"edusur-educational\",\n41:     indexCode: \"02\",\n42:     title: \"Edusur Educational Platform\",\n43:     client: \"Edusur Servicios Educativos\",\n44:     year: \"2026\",\n45:     category: \"Web Apps\",\n46:     featured: true,\n47:     summary: \"High-performance Astro 5 web experience with GSAP micro-animations.\",\n48:     description:\n49:       \"A fast, content-driven educational website featuring 14 custom sections, student review engines, and sub-second load times.\",\n50:     tags: [\"Astro 5\", \"TypeScript\", \"Tailwind 4\", \"GSAP 3\", \"EmailJS\"],\n51:     metrics: [\n52:       { label: \"Framework\", value: \"Astro 5.3\" },\n53:       { label: \"Custom Sections\", value: \"14 Sections\" },\n54:       { label: \"Lighthouse Score\", value: \"98/100\" },\n55:     ],\n56:     caseStudy: {\n57:       challenge:\n58:         \"Edusur needed a modern, highly engaging web portal for prospective students that loaded instantly on mobile networks while maintaining smooth animations.\",\n59:       solution:\n60:         \"Implemented a content-driven architecture using Astro 5 and Tailwind CSS v4, utilizing GSAP for hardware-accelerated scroll animations and zero JS runtime overhead for static content.\",\n61:       architecture: [\n62:         \"Astro 5 island architecture for zero JS default shipped\",\n63:         \"Tailwind CSS 4.0 for utility styling\",\n64:         \"GSAP 3 scroll-triggered timeline animations\",\n65:         \"EmailJS client-side secure lead capture\",\n66:       ],\n67:       results: [\n68:         \"Achieved sub-500ms First Contentful Paint on mobile\",\n69:         \"98/100 Lighthouse performance rating\",\n70:         \"14 responsive custom sections built with strict modularity\",\n71:       ],\n72:     },\n73:     demoUrl: \"https://edusur.edu.co\",\n74:   },\n75:   {\n76:     id: \"salesforce-agentforce-omni\",\n77:     indexCode: \"03\",\n78:     title: \"Salesforce Agentforce & OmniChannel Engine\",\n79:     client: \"Enterprise Consulting\",\n80:     year: \"2026\",\n81:     category: \"Consulting\",\n82:     featured: true,\n83:     summary: \"Automated Omni-Channel customer routing & Agentforce AI integration suite.\",\n84:     description:\n85:       \"Architecture design and custom LWC integration for enterprise Salesforce CRM deployments, automating Omni-Channel routing, case escalation flows, and AI Agentforce assistants.\",\n86:     tags: [\"Salesforce\", \"LWC\", \"Agentforce AI\", \"Omni-Channel\", \"Apex\", \"Flow Automation\"],\n87:     metrics: [\n88:       { label: \"Routing Latency\", value: \"<1.2s\" },\n89:       { label: \"Case Automation\", value: \"85% Auto-Routed\" },\n90:       { label: \"Integration\", value: \"Agentforce AI\" },\n91:     ],\n92:     caseStudy: {\n93:       challenge:\n94:         \"Enterprise customer support teams faced high queue wait times due to manual case categorization and fragmented digital communication channels.\",\n95:       solution:\n96:         \"Engineered an automated Omni-Channel routing matrix combined with custom Lightning Web Components (LWC) and Agentforce AI assistants to auto-triage incoming cases.\",\n97:       architecture: [\n98:         \"Salesforce Service Cloud Omni-Channel skill-based routing\",\n99:         \"Agentforce AI digital engagement connectors\",\n100:         \"Custom Lightning Web Component (LWC) widgets for agent dashboards\",\n101:         \"Declarative Flow automation for case status lifecycle\",\n102:       ],\n103:       results: [\n104:         \"Reduced average case triage time by 85%\",\n105:         \"Seamless AI-to-human agent handoff for complex support inquiries\",\n106:         \"Enhanced customer satisfaction CSAT by +28%\",\n107:       ],\n108:     },\n109:   },\n110:   {\n111:     id: \"aca-diario-digital\",\n112:     indexCode: \"04\",\n113:     title: \"Acá — Diario Digital de Ipiales\",\n114:     client: \"Acá Medios\",\n115:     year: \"2026\",\n116:     category: \"Web Apps\",\n117:     featured: true,\n118:     summary: \"High-velocity digital newspaper & self-managed advertising engine.\",\n119:     description:\n120:       \"A modern local journalism platform built for fast editorial workflows (draft -> review -> publish in <4h) with self-hosted ad management.\",\n121:     tags: [\"Next.js 14\", \"Tailwind 4\", \"PostgreSQL\", \"Monorepo\", \"Local CMS\"],\n122:     metrics: [\n123:       { label: \"Target Visits\", value: \"50K/mo\" },\n124:       { label: \"Publish SLA\", value: \"<4 Hours\" },\n125:       { label: \"Infra Cost Target\", value: \"$0-$5/mo\" },\n126:     ],\n127:     caseStudy: {\n128:       challenge:\n129:         \"Local news in Nariño/Ecuador border region lacked modern digital publishing tools, requiring a cheap-to-operate platform supporting local ad sales without third-party ad network dependencies.\",\n130:       solution:\n131:         \"Built a lightweight monorepo application in Next.js 14 with a custom editorial rich-text workflow and a self-managed banner advertising rotation system.\",\n132:       architecture: [\n133:         \"Next.js 14 App Router monorepo architecture\",\n134:         \"Internal ad banner manager (weight-based rotation & date caps)\",\n135:         \"Role-based editorial workflow (Draft, Review, Scheduled, Live)\",\n136:         \"Static page generation for viral article traffic bursts\",\n137:       ],\n138:       results: [\n139:         \"Designed to scale to 50,000 monthly visits at near-zero hosting cost\",\n140:         \"Streamlined article publishing loop to under 4 hours\",\n141:         \"Direct monetization via local business ad placements\",\n142:       ],\n143:     },\n144:     demoUrl: \"https://diarioaca.co\",\n145:   },\n146:   {\n147:     id: \"apex-analytics\",\n148:     indexCode: \"05\",\n149:     title: \"Apex Telemetry Platform\",\n150:     client: \"Apex Enterprise Systems\",\n151:     year: \"2025\",\n152:     category: \"SaaS\",\n153:     featured: false,\n154:     summary: \"High-throughput real-time telemetry and streaming data platform.\",\n155:     description:\n156:       \"Engineered an enterprise telemetry dashboard handling over 10M events/day with sub-50ms query latencies.\",\n157:     tags: [\"Next.js 16\", \"React 19\", \"ClickHouse\", \"WebSockets\", \"Tailwind 4\"],\n158:     metrics: [\n159:       { label: \"Throughput Boost\", value: \"+340%\" },\n160:       { label: \"Query Latency\", value: \"<50ms\" },\n161:       { label: \"Daily Events\", value: \"10M+\" },\n162:     ],\n163:     caseStudy: {\n164:       challenge:\n165:         \"The legacy dashboard suffered from severe rendering freezes and API bottlenecks under heavy concurrent telemetry loads.\",\n166:       solution:\n167:         \"Re-architected the frontend using React 19 concurrent features, streaming server components, and WebSocket chunking with ClickHouse analytics queries.\",\n168:       architecture: [\n169:         \"Next.js App Router streaming server render\",\n170:         \"ClickHouse columnar DB integration\",\n171:         \"High-performance canvas rendering engine\",\n172:         \"Real-time WebSocket data pipelines\",\n173:       ],\n174:       results: [\n175:         \"Reduced dashboard initial load time from 4.2s to 0.4s\",\n176:         \"Supported 500+ concurrent live telemetry views\",\n177:         \"Zero UI frame drops during peak events\",\n178:       ],\n179:     },\n180:     demoUrl: \"https://apex.buildroot.dev\",\n181:   },\n182:   {\n183:     id: \"buildroot-agent-system\",\n184:     indexCode: \"06\",\n185:     title: \"buildroot_ Agentic AI Workflow Engine\",\n186:     client: \"buildroot_ Labs\",\n187:     year: \"2026\",\n188:     category: \"Labs\",\n189:     featured: false,\n190:     isLab: true,\n191:     summary: \"Multi-agent autonomous software engineering lifecycle framework.\",\n192:     description:\n193:       \"Orchestration engine coordinating 6 specialized AI agents (Requirements, Architecture, Frontend, QA, Copywriting, DevOps) with automated handoff gates.\",\n194:     tags: [\"Antigravity AGY\", \"Multi-Agent\", \"TypeScript\", \"AI Automation\", \"Workflows\"],\n195:     metrics: [\n196:       { label: \"Agent Roles\", value: \"6 Specialized\" },\n197:       { label: \"Cycle Speed\", value: \"3x Faster\" },\n198:       { label: \"QA Checkpoints\", value: \"5-Axis Audit\" },\n199:     ],\n200:     caseStudy: {\n201:       challenge:\n202:         \"Traditional single-prompt AI coding assistants suffer from context drift, forgotten requirements, and lack of systematic architectural review.\",\n203:       solution:\n204:         \"Developed a structured multi-agent workflow system partitioning project phases into specialized roles with strict deliverable handoffs and automated quality validation.\",\n205:       architecture: [\n206:         \"Role-based agent definitions (Requirements Engineer, Solution Architect, Frontend Dev, QA Engineer, DevOps, Copywriter)\",\n207:         \"Slash command workflow orchestration (/startcycle)\",\n208:         \"Automated 5-axis code quality & accessibility audit checklists\",\n209:         \"Markdown artifact persistence & transcript traceability\",\n210:       ],\n211:       results: [\n212:         \"Eliminated context degradation on complex multi-step features\",\n213:         \"Ensured WCAG 2.1 AA accessibility and performance target compliance\",\n214:         \"Built-in continuous improvement via skill & memory persistence\",\n215:       ],\n216:     },\n217:     githubUrl: \"https://github.com/nicommit/buildroot\",\n218:   },\n219: ];\n220: \nThe above content shows the entire, complete file contents of the requested file.\n"}
